// TestAIHelpCoverageGenerated fails when a visible umbrella-owned command renders
// identical help with AI mode off and on — meaning its AIDescription is empty or
// not wired through ResolveDescription. Commands from embedded plugins are
// excluded; they are checked in their own repos.
func TestAIHelpCoverageGenerated(t *testing.T) {
	defer os.Unsetenv("JFROG_CLI_AI_HELP")
	embedded := aiHelpEmbeddedLeafPaths(t)
	human := collectLocalUsagesGenerated(t, "false", embedded)
	ai := collectLocalUsagesGenerated(t, "true", embedded)
	skips := aiHelpSkipSet()

	var missing []string
	for name, humanUsage := range human {
		if aiHelpSkipped(name, skips) {
			continue
		}
		if ai[name] == humanUsage {
			missing = append(missing, name)
		}
	}
	sort.Strings(missing)

	if len(missing) > 0 {
		t.Fatalf("%d visible umbrella command(s) missing AI help (AIDescription empty or not routed through ResolveDescription):\n  %s\n\n"+
			"Add a GetAIDescription() to each command's docs help.go and resolve it via corecommon.ResolveDescription, "+
			"mark the command Hidden if it is not meant for agents, or pass it to the action's skip-commands input.",
			len(missing), strings.Join(missing, "\n  "))
	}
}
