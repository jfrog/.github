// aiHelpSkipSet parses AIHELP_SKIP_COMMANDS (comma/newline separated command
// paths) into a list. An empty value means "check every command".
func aiHelpSkipSet() []string {
	raw := os.Getenv("AIHELP_SKIP_COMMANDS")
	var out []string
	for _, part := range strings.FieldsFunc(raw, func(r rune) bool { return r == ',' || r == '\n' }) {
		if s := strings.TrimSpace(part); s != "" {
			out = append(out, s)
		}
	}
	return out
}

// aiHelpSkipped reports whether name is excluded — either an exact match or a
// parent path, so skipping "mc" drops the whole "mc" subtree.
func aiHelpSkipped(name string, skips []string) bool {
	for _, s := range skips {
		if name == s || strings.HasPrefix(name, s+" ") {
			return true
		}
	}
	return false
}

