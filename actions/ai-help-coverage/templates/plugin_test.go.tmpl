	missingSet := map[string]bool{}
	for _, app := range aiHelpApps() {
		human := collectAIHelpUsagesGenerated(t, app, "false")
		ai := collectAIHelpUsagesGenerated(t, app, "true")
		for name, humanUsage := range human {
			if aiHelpSkipped(name, skips) {
				continue
			}
			if ai[name] == humanUsage {
				missingSet[name] = true
			}
		}
